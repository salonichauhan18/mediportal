    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.1.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^11.1.0",
    "puppeteer": "^24.42.0",
    "reflect-metadata": "^0.2.0",
