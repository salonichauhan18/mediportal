{
  "expo": {
    "name": "MediPortal Patient",
    "slug": "mediportal-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "scheme": "mediportal",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mediportal.patient",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MediPortal uses Face ID to securely access your health records.",
        "NSCameraUsageDescription": "MediPortal uses your camera to scan QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.mediportal.patient",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MediPortal to use Face ID for secure login."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
